{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Atrix21/typetrace",
  "title": "TypeTrace",
  "description": "Finds the code an AI coding agent needs: file:line pointers plus callers and callees, locally.",
  "repository": {
    "url": "https://github.com/Atrix21/typetrace",
    "source": "github"
  },
  "websiteUrl": "https://github.com/Atrix21/typetrace",
  "version": "0.3.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "typetrace-cli",
      "version": "0.3.2",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    },
    {
      "registryType": "pypi",
      "identifier": "typetrace",
      "version": "0.3.2",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "serve"
        }
      ]
    }
  ]
}
