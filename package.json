{
  "name": "typetrace-cli",
  "version": "0.1.0",
  "description": "Code search + typed call graph for AI coding agents (MCP). Finds the code that matters for a task in one call; benchmarked head-to-head against graphify and code-review-graph.",
  "author": "Atrix21",
  "license": "MIT",
  "type": "module",
  "bin": {
    "typetrace": "bin/typetrace.js",
    "typetrace-cli": "bin/typetrace.js"
  },
  "files": [
    "bin/",
    "dist/",
    "grammars/",
    "scripts/embeddings/embed-onnx.mjs",
    "scripts/embeddings/embed.py",
    "scripts/embeddings/embed_server.py",
    "benchmark.config.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Atrix21/typetrace.git"
  },
  "homepage": "https://github.com/Atrix21/typetrace#readme",
  "bugs": {
    "url": "https://github.com/Atrix21/typetrace/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "claude-code",
    "ai-agents",
    "code-search",
    "code-graph",
    "call-graph",
    "typescript",
    "python",
    "retrieval",
    "rag",
    "benchmark"
  ],
  "scripts": {
    "setup:target": "tsx src/cli/index.ts setup-target",
    "setup:competitors": "bash scripts/setup-competitors.sh",
    "index": "tsx src/cli/index.ts index",
    "graph:build": "tsx src/cli/index.ts graph-build",
    "graph:validate": "tsx src/cli/index.ts graph-validate",
    "benchmark": "tsx src/cli/index.ts benchmark",
    "benchmark:ablation": "tsx src/cli/index.ts ablation",
    "report": "tsx src/cli/index.ts report",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "agent-eval": "tsx src/agent-eval/cli.ts",
    "typetrace": "node bin/typetrace.js",
    "setup": "bash scripts/setup-competitors.sh && tsx src/cli/index.ts setup-target",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@vscode/ripgrep": "1.18.0",
    "js-tiktoken": "1.0.21",
    "stemmer": "2.0.1",
    "tree-sitter-wasms": "0.1.13",
    "typescript": "5.9.3",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "roughjs": "4.6.6",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  }
}
